# ── Web Portal OAuth App ──
# Callback URL to register: http://localhost:4000/auth/github/callback
GITHUB_CLIENT_ID=your_web_app_client_id
GITHUB_CLIENT_SECRET=your_web_app_client_secret
GITHUB_REDIRECT_URI_WEB=http://localhost:4000/auth/github/callback

# ── CLI OAuth App (separate GitHub OAuth App) ──
# Callback URL to register: http://localhost:9876/callback
GITHUB_CLI_CLIENT_ID=your_cli_app_client_id
GITHUB_CLI_CLIENT_SECRET=your_cli_app_client_secret
GITHUB_REDIRECT_URI_CLI=http://localhost:9876/callback

# ── JWT Secrets — generate with: openssl rand -base64 64 ──
ACCESS_TOKEN_SECRET=replace_with_long_random_string
REFRESH_TOKEN_SECRET=replace_with_different_long_random_string

# ── Token Expiry ──
ACCESS_TOKEN_EXPIRY=180
REFRESH_TOKEN_EXPIRY=300

# ── Server ──
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
DB_PATH=./insighta.db

# ── Frontend URL (for OAuth redirect after login) ──
WEB_APP_URL=http://localhost:3000
